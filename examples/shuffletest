#!/usr/bin/env bash
set -u
. "$(dirname "$0")/checks.sh"

acv identity id.amp

icat(){
    for f in "$@";
    do
        #convert  $f -resize 1000x\> png:- |img2sixel -I
        convert  "$f" -resize 1000x1000 sixel:-
    done
}

test_shuffle() {
    local method="$1"
    local size="$2"
    echo "--- Test test_shuffle $method $size ---"
    rm -f cb10.jpg cb10.csv
    chart --generate cb10.jpg --grid $size --shuffle "$method" && icat cb10.jpg
    chart --grid $size --shuffle "$method" cb10.jpg cb10.csv && acv show cb10.csv
    # A chart generated and read back with the same shuffle must come out as the
    # identity: every patch found at the level it was printed at.
    check "shuffle $method $size" "$(acv -q error cb10.csv id.amp) < 2"
}

test_shuffle hilbert 32
test_shuffle shuffle 32
test_shuffle blue_noise 32
test_shuffle split 32
test_shuffle maximize_closest 32
test_shuffle gcd 32

test_shuffle hilbert 16
test_shuffle shuffle 16
test_shuffle blue_noise 16
test_shuffle split 16
test_shuffle maximize_closest 16
test_shuffle gcd 16

#test_shuffle hilbert 10
test_shuffle shuffle 10
test_shuffle blue_noise 10
test_shuffle split 10
test_shuffle maximize_closest 10
test_shuffle gcd 10

rm -f id.amp cb10.jpg cb10.csv
