    print(f"j1:{j1}")
#---------------------


def permute_shuffle(x):
    result = x.copy()
    random.shuffle(result)
    return result
#---------------------


def best_stride_maximin_manhattan(
    n: int,
    *,
    torus: bool = False,
    include_wrap: bool = True,
) -> tuple[int, dict]:
    """
    Choose a stride s (1 <= s < L=n*n, gcd(s,L)=1) that maximizes the minimum
    Manhattan distance between consecutive visited cells when iterating
        idx <- (idx + s) mod L
    with idx mapped to (x=idx%n, y=idx//n).

    torus=False: standard Manhattan on the grid coordinates.
    torus=True : toroidal (Lee) distance: dx=min(|dx|, n-|dx|), same for dy.

    include_wrap=True includes the final step returning to the start (L moves);
    otherwise considers only the first L-1 moves.
    Returns (best_s, stats_dict).
    """
    if n <= 1:
        raise ValueError("n must be >= 2")
    L = n * n
    moves = L if include_wrap else (L - 1)

    def step_dist(a: int, b: int) -> int:
        ax, ay = a % n, a // n
        bx, by = b % n, b // n
        dx = abs(bx - ax)
        dy = abs(by - ay)
        if torus:
            dx = min(dx, n - dx)
            dy = min(dy, n - dy)
        return dx + dy

    best_s = None
    best_key = None
    best_stats = None

    for s in range(1, L):
        if gcd(s, L) != 1:
            continue

        idx = 0
        dmin = 10**9
        dsum = 0

        for _ in range(moves):
            nxt = (idx + s) % L
            d = step_dist(idx, nxt)
            if d < dmin:
                dmin = d
                # Early exit: if already worse than current best min, stop.
                if best_key is not None and dmin < best_key[0]:
                    break
            dsum += d
            idx = nxt
        else:
            davg = dsum / moves
            key = (davg, dmin, -s)  # maximize min, then average; tie -> smaller s
            if best_key is None or key > best_key:
                best_key = key
                best_s = s
                best_stats = {"L": L, "min_dist": dmin, "avg_dist": davg, "torus": torus}

    assert best_s is not None
    return best_s, best_stats

def permute_gcd(x):
    side = int(len(x) ** 0.5)
    s, stats = best_stride_maximin_manhattan(side)
    dbg(f"permute_gcd: s:{s} stats:{stats}")
    return [x[(i*s)%len(x)] for i in range(len(x))]

#---------------------
def permute(x,method='blue_noise'):
    random.seed(0)
    np.random.seed(0)
    if method == 'none':
        return x
    elif method == 'blue_noise':
        return permute_blue_noise(x)
    elif method == 'hilbert':
        return permute_hilbert(x)
    elif method == 'split':
        return permute_split(x)
    elif method == 'shuffle':
        return permute_shuffle(x)
    elif method == 'maximize_closest':
        return permute_maximize_closest(x)
    elif method == 'gcd':
        return permute_gcd(x)
    else:
        raise ValueError(f"Unknown permutation method: {method}")
#---------------------

def order_points(pts: np.ndarray) -> np.ndarray:
    """Return 4 points ordered as (tl, tr, br, bl)."""
    pts = pts.reshape(4, 2).astype(np.float32)
    s = pts.sum(axis=1)
    d = np.diff(pts, axis=1).reshape(-1)
    tl = pts[np.argmin(s)]
    br = pts[np.argmax(s)]
    tr = pts[np.argmin(d)]
    bl = pts[np.argmax(d)]
    return np.stack([tl, tr, br, bl], axis=0)


def find_grid_quad(gray: np.ndarray) -> np.ndarray | None:
    """Try to find the outer grid border as a 4-point contour; return 4 ordered points or None."""

    def try_find_quad(img, label=""):
        g = cv2.GaussianBlur(img, (5, 5), 0)
        edges = cv2.Canny(g, 50, 150)
        edges = cv2.dilate(edges, None, iterations=1)

        cnts, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cnts = sorted(cnts, key=cv2.contourArea, reverse=True)[:10]
        #dbg(f"{label}: Found {len(cnts)} contours")

        for c in cnts:
            peri = cv2.arcLength(c, True)
            approx = cv2.approxPolyDP(c, 0.02 * peri, True)
            if(len(approx) !=4):
                continue
            area = cv2.contourArea(approx)
            area_ratio = area / img.size
            #dbg(f"{label}: {len(approx)} points, ratio={area_ratio:.3f} {approx}")

            if len(approx) == 4 and area_ratio > 0.10:
                return order_points(approx)
        return None

    gmin, gmax = np.min(gray), np.max(gray)
    dbg(f"Image range: {gmin} to {gmax}")
    quad = try_find_quad(gray -gmin, "ORIGINAL")
    if quad is not None:
        return quad

    return try_find_quad(gmax - gray - gmin, "INVERTED")

def warp_to_square(gray: np.ndarray, quad: np.ndarray | None, size: int) -> np.ndarray:
    """Perspective-warp to a square canvas of given size; if quad is None, just resize."""
    if quad is None:
        return cv2.resize(gray, (size, size), interpolation=cv2.INTER_AREA)

    dst = np.array([[0, 0], [size - 1, 0], [size - 1, size - 1], [0, size - 1]], np.float32)
    M = cv2.getPerspectiveTransform(quad, dst)
    return cv2.warpPerspective(gray, M, (size, size), flags=cv2.INTER_CUBIC)


def measure_patches(warped: np.ndarray, grid: int = 10, roi_frac: float = 2 / 3) -> np.ndarray:
    """Return 100 medians (row-major) measured from a centered square ROI in each cell."""
    h, w = warped.shape
    cw, ch = w / grid, h / grid
    roi_side = int(round(min(cw, ch) * roi_frac))
    roi_side = max(1, roi_side)
    half = roi_side // 2

    medians = []
    for r in range(grid):
        for c in range(grid):
            cx = int(round((c + 0.5) * cw))
            cy = int(round((r + 0.5) * ch))
            x0, x1 = max(0, cx - half), min(w, cx - half + roi_side)
            y0, y1 = max(0, cy - half), min(h, cy - half + roi_side)
            roi = warped[y0:y1, x0:x1]
            median_val = float(np.median(roi))
            medians.append(median_val)
            warped[y0:y1, x0:x1] = 0   # Replace ROI with median value
            warped[y0+1:y1-1, x0+1:x1-1] = median_val   # Replace ROI with median value
    return np.array(medians, dtype=np.float32)


def normalize_to_0_255(vals: np.ndarray) -> np.ndarray:
    vmin = float(vals.min())
    vmax = float(vals.max())
    if vmax <= vmin:
        return np.zeros_like(vals, dtype=np.uint8)
    out = (vals - vmin) * (255.0 / (vmax - vmin))
    return np.clip(np.rint(out), 0, 255).astype(np.uint8)


def write_chart(data: list[tuple[int, int]], out_path: str, cell: int, margin: int, grid: int, line: int, border: int, label: str = "") -> None:
    """
    Write a chart image from data list.
    data: list of (intended_level, actual_level) tuples
    """
    side = grid * cell + 2 * margin
    img = np.full((side, side), 255, dtype=np.uint8)

    # Inner square where the grid lives
    x0, y0 = margin, margin
    x1, y1 = margin + grid * cell, margin + grid * cell

    # Outer border (black)
    cv2.rectangle(img, (x0, y0), (x1, y1), 0, thickness=border)

    # Extract levels from data
    levels = np.array([y for x, y in data], dtype=np.uint8)

    k = 0
    for r in range(grid):
        for c in range(grid):
            px0 = x0 + c * cell
            py0 = y0 + r * cell
            px1 = px0 + cell
            py1 = py0 + cell

            # Leave a little breathing room so grid lines don't contaminate the ROI
            pad = max(1, line // 2 + 2)
            cv2.rectangle(
                img,
                (px0 + pad, py0 + pad),
                (px1 - pad, py1 - pad),
                int(levels[k]),
                thickness=-1,
            )
            k += 1

    # Internal grid lines (black)
    if line > 0:
        for i in range(1, grid):
            x = x0 + i * cell
            y = y0 + i * cell
            cv2.line(img, (x, y0), (x, y1), 0, thickness=line)
            cv2.line(img, (x0, y), (x1, y), 0, thickness=line)

    # Write label at the bottom
    if not label:
        label = f"chart from data, file={out_path}"
    cv2.putText(img, label, (10, side - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, 0, 1)

    if out_path.endswith(".tif"):
        dbg(f"Converting data to 16-bit")
        img = (img.astype(np.float32) * 257).astype(np.uint16)  # Scale 8-bit to 16-bit

    if not cv2.imwrite(out_path, img):
        raise RuntimeError(f"Failed to write chart image: {out_path}")
    dbg(f"Saved chart image: {out_path}")


def generate_chart(a) -> None:
    """
    Create a printable grid x grid ramp chart:
    - Outer thick black border (easy quad detection)
    - Thin internal grid lines
    - Patches filled with x levels 0..255 (row-major)
    """
    out_path = a.generate
    # Patch levels
    levels = np.rint(np.linspace(0, 255, a.grid * a.grid)).astype(np.uint8)
    if a.invert_chart:
        levels = (255 - levels).astype(np.uint8)

    shuffled = permute(levels, a.shuffle)

    # Create data as (intended, actual) pairs
    data = [(int(levels[i]), int(shuffled[i])) for i in range(len(levels))]

    label = f"shuffle={a.shuffle} invert={a.invert_chart} grid={a.grid} cell={a.cell} border={a.border} file={out_path}"
    write_chart(data, out_path, a.cell, a.margin, a.grid, a.line, a.border, label)

def write_csv(filename: str, curve: list[tuple[int, int]]) -> None:
    """Write (x, y) data pairs to CSV file in the format used by acv."""
    with open(filename, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["channel", "x", "y"])
        for x, y in curve:
            w.writerow([0, x, y])

def read_chart(a) -> list[tuple[int, int]]:
#def read_chart(image_path: str, out_csv: str, grid: int, size: int, shuffle: str, debug: str, border: int, cell: int ) -> list[tuple[int, int]]:
    """Read and analyze a ramp chart from an image."""
    image_path = a.image

    gray = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)
    if gray is None:
        dbg(f"Error: cannot read image: {image_path}")
        return []

    quad = find_grid_quad(gray)
    if quad is None:
        dbg("Warning: could not detect outer grid border; using full image.")

    warped = warp_to_square(gray, quad, a.warpsize)

    # Crop out half the margin
    chart_side = a.grid * a.cell +  a.border
    margin_pixels = int(a.border/2 *a.warpsize/chart_side )
    warped = warped[margin_pixels:-margin_pixels, margin_pixels:-margin_pixels]


    med = measure_patches(warped, grid=a.grid, roi_frac=2 / 3)

    if a.debug:
        cv2.imwrite(a.debug, warped)
        dbg(f"Debug image written to: {a.debug}")

    # y: normalize so darkest measured = 0 and lightest measured = 255
    y = normalize_to_0_255(med)

    # Enforce increasing direction assuming chart is darkest->lightest row-major.
    #if shuffle == "none" and med[0] > med[-1]:
    #    y = (255 - y).astype(np.uint8)

    # x: intended ramp levels 0..255 across 100 patches (row-major)
    x = np.rint(np.linspace(0, 255, a.grid * a.grid)).astype(np.uint8)
    x = permute(x, a.shuffle)

    data = [(int(xi), int(yi)) for xi, yi in zip(x, y)]
    write_csv(a.out_csv, data)

    dbg(f"Read {len(x)} patches from {image_path} and wrote to {a.out_csv}")
    return data

def generate_variance_chart( data: list[tuple[int, int]], a) -> None:
    """
     Some variance in chart values is due to enlarger light falloff. With a 32x32 chart and
     shuffled patches there are 4 samples per level spread across the image. The average
     of those levels gives a better estimate of the true level, and variance of a patch
     from the best estimate is a sample of the error due to light falloff.
     This function writes a chart where each patch is the difference between the measured
     value and the best estimate value.
    """
    out_path = a.variance
    grid = a.grid
    #`dbg(f"Generating variance chart from {(data)} measurements")
    # Group data by intended level (x value)
    level_groups = defaultdict(list)
    for x, y in data:
        level_groups[x//2].append(y)
    #dbg(f"Level groups: {level_groups}")

    # Calculate best estimates using leave_one_out for each group
    variance_data = []
    for x, y in data:
        group = level_groups[x//2]
        if len(group) > 1 and y != 0 :
            # Leave-one-out mean: exclude this specific measurement
            leave_one_out_mean = (sum(group) - y) / (len(group) - 1)
            variance = (y - leave_one_out_mean)/leave_one_out_mean
            #dbg(f"variance {x} y:{y} m:{leave_one_out_mean} v:{variance:.0f}")
        else:
            # Single measurement: no variance to calculate
            variance = 0

        variance_level = int(np.clip(-variance + 128, 0, 255))
        variance_data.append((x, variance_level))

    # Write variance chart using write_chart
    label = f"variance chart from {len(data)} measurements"
    write_chart(variance_data, out_path, cell=40, margin=80, grid=grid, line=1, border=10, label=label)
    csvfile = os.path.splitext(out_path)[0] + ".csv"
    write_csv(csvfile, variance_data)


def white_value(dtype):
    """Full-scale value for a bit depth. 255 is nearly black in 16-bit."""
    return 65535 if dtype == np.uint16 else 255

def generate_bar_image(width, height, segments, dtype) -> np.ndarray:
    """Generate a black/white bar image with black center and a white segment on each end."""
    img = np.full((height, width), 0, dtype=dtype)  # Start with black
    white = white_value(dtype)

    segment_height = height / segments

    # Top white bar (1 segment)
    top_end = int(segment_height)
    img[0:top_end, :] = white

    # Bottom white bar (1 segment)
    bottom_start = int((segments-1) * segment_height)
    img[bottom_start:height, :] = white

    return img

def generate_step_wedge_image(a) -> np.ndarray:
    #out_path: str, segments: int = 21, progression: str = "linear", width: int = 200, height: int = 1000, 
    #                    include_gradient: bool = True, include_bars: bool = True) -> None:
    """
    Generate a step wedge chart with N segments (default 21).
    Optionally includes a vertical gradient and black/white bars.
    """
    include_gradient = True
    include_bars = True
    segments = a.segments
    stops_per_segment = 1/3
    total_width = 200
    width = total_width
    height = 1000
    grad_width = 50
    bar_width = 20

    
    # Add space for gradient and bars if requested
    if include_gradient:
        width -= grad_width
    if include_bars:
        width -= bar_width
    
    img = np.full((height, total_width), 255, dtype=np.uint8)
    
    # Draw step wedge
    segment_height = height / segments
    for j in range(segments):
        y_start = int(j * segment_height)
        y_end = int((j + 1) * segment_height + 1)
        if a.progression == "linear":
            value = round(255 - 255 * (j / (segments - 1)))
            reflectance = value / 255.0
        if a.progression == "stops":
            value = round(255 * (2 ** (-j * stops_per_segment)))
            reflectance = value / 255.0
        if a.progression == "inv_stops":
            inverted_value = round(255 * (2 ** (-j * stops_per_segment)))
            value = 255 - inverted_value
            reflectance = inverted_value / 255.0

        density = -np.log10(reflectance) if reflectance > 0 else float('inf')
        img[y_start:y_end, 0:width] = value
        
        # Add segment number text
        text_value = 0 if value >= 128 else 255
        cv2.putText(img, str(j + 1), (10, y_start + 20), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.7, text_value, 1, cv2.LINE_AA)
        # Add value at bottom left
        cv2.putText(img, f"{value:.0f} D:{density:.2f}", (10, y_end - 10), 
                   cv2.FONT_HERSHEY_SIMPLEX, 0.3, text_value, 1, cv2.LINE_AA)
    
    x_offset = width
    
    # Draw vertical gradient if requested
    if include_gradient:
        for y in range(height):
            value = int(255 * (1 - y / height))
            img[y, x_offset:x_offset + grad_width] = value
        x_offset += grad_width
    
    # Draw black/white bars if requested
    if include_bars:
        bar_img = generate_bar_image(bar_width, height, segments, np.uint8)
        img[0:height, x_offset:x_offset + bar_width] = bar_img

    return img
    
def generate_step_wedge(a) -> None:
    out_path = a.image
    img = generate_step_wedge_image(a)
    if not cv2.imwrite(out_path, img):
        raise RuntimeError(f"Failed to write step wedge: {out_path}")
    dbg(f"Saved step wedge: {out_path}")


def apply_curve_to_image(image: np.ndarray, curves: list[list[tuple[int, int]]]) -> np.ndarray:
    """Apply curve(s) to an image using OpenCV LUT.
    
    If curves has 1 channel, apply to all image channels.
    If curves has multiple channels, apply each to corresponding image channel.
    """
    # Determine bit depth
    dbg(f"apply_curve_to_image: image.dtype={image.dtype}")
    lut_size, scale = (65536, 257) if (image.dtype == np.uint16) else (256, 1)
 
    def build_lut(curve):
        lut = np.arange(lut_size, dtype=np.float32)
        
        if len(curve) > 0:
            # Scale curve points to match bit depth
            x_vals = np.array([x * scale for x, _ in curve], dtype=np.float32)
            y_vals = np.array([y * scale for _, y in curve], dtype=np.float32)
            
            # Extend to full range if needed
            if x_vals[0] > 0:
                x_vals = np.insert(x_vals, 0, 0)
                y_vals = np.insert(y_vals, 0, y_vals[0])
            if x_vals[-1] < lut_size - 1:
                x_vals = np.append(x_vals, lut_size - 1)
                y_vals = np.append(y_vals, y_vals[-1])
            
        return np.clip(np.interp(lut, x_vals, y_vals), 0, lut_size - 1).astype(image.dtype)
        
    # Spline fill first, the way acv does, so a 16 point .acv means the same curve
    # here as it does to acv, Photoshop and ffmpeg. fill_curve is a no-op on a curve
    # that is already a 0..255 mapping.
    luts = [build_lut(curve) for curve in fill_curve(curves)]

    # Apply LUTs to image channels
    if len(image.shape) == 2:
        return luts[0][image]
    
    channels = cv2.split(image)
    if len(luts) == 1:
        result_channels = [luts[0][ch] for ch in channels]
    else:
        result_channels = [luts[min(i, len(luts)-1)][ch] for i, ch in enumerate(channels)]
    
    return cv2.merge(result_channels)


def ensure_portrait(img: np.ndarray) -> np.ndarray:
    """Rotate image to portrait orientation if it's landscape."""
    h, w = img.shape[:2]
    if w > h:
        return cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)
    return img


def apply_curve(a) -> None:
    """Apply a curve file to an image."""
    input_path = a.image
    curve_path, output_path = a.apply
    # Read image
    img = cv2.imread(input_path, cv2.IMREAD_UNCHANGED)
    if img is None:
        raise ValueError(f"Cannot read image: {input_path}")

    img = ensure_portrait(img)

    # Create step wedge if requested
    if a.step_wedge:
        wedge = generate_step_wedge_image(a)
        wedge_width = wedge.shape[1]
    else:
        wedge_width = 0

    # Add margin before resizing
    if a.margin > 0:
        h, w = img.shape[:2]
        new_shape = (h + 2*a.margin, w + 2*a.margin) + (img.shape[2:] if len(img.shape) == 3 else ())
        new_img = np.full(new_shape, white_value(img.dtype), dtype=img.dtype)
        new_img[a.margin:a.margin+h, a.margin:a.margin+w] = img
        img = new_img
        dbg(f"Added {a.margin}px margin: {w}x{h} -> {img.shape[1]}x{img.shape[0]}")

    # Resize if requested
    if a.size:
        h, w = img.shape[:2]
        scale_w, scale_h = (a.size - wedge_width) / w, a.size / h
        scale = min(scale_w, scale_h)
        new_w, new_h = int(w * scale), int(h * scale)
        interp = cv2.INTER_AREA if scale < 1 else cv2.INTER_LANCZOS4
        img = cv2.resize(img, (new_w, new_h), interpolation=interp)
        dbg(f"Resized from {w}x{h} to {new_w}x{new_h}")  

    curves = read_curve(curve_path)
    
    dbg(f"Applying {len(curves)} curve channel(s) with {len(curves[0])} points to image")

    # Apply curves
    result = apply_curve_to_image(img, curves)

    # Append step wedge if requested
    if a.step_wedge:
        # Apply curves to wedge too
        wedge = apply_curve_to_image(wedge, curves)

        # Pad wedge height to match result height if needed
        pad_height = result.shape[0] - wedge.shape[0]
        if pad_height > 0:
            half_pad = pad_height // 2
            bottom_pad = np.zeros((half_pad, wedge.shape[1]), dtype=wedge.dtype)
            top_pad = np.full((pad_height - half_pad, wedge.shape[1]), 255, dtype=wedge.dtype)
            wedge = np.vstack([top_pad, wedge, bottom_pad])
        if pad_height < 0:
            pad = generate_bar_image(result.shape[1], -pad_height, a.segments, result.dtype)
            if len(result.shape) == 3:
                pad = cv2.cvtColor(pad, cv2.COLOR_GRAY2BGR)
            result = np.vstack([result, pad])

        # Match bit depth
        if result.dtype == np.uint16:
            wedge = (wedge.astype(np.uint16) * 257)


        # Match channels
        if len(result.shape) == 3:
            wedge = cv2.cvtColor(wedge, cv2.COLOR_GRAY2BGR)

        result = np.hstack([result, wedge])
 
    # Convert to grayscale before saving
    if len(result.shape) == 3:
        dbg(f"Converting data to grayscale")
        result = cv2.cvtColor(result, cv2.COLOR_BGR2GRAY)


    # apply_curve_to_image preserves the input depth, so 16-bit data is already scaled
    if output_path.endswith(".tif") and result.dtype != np.uint16:
        dbg(f"Converting data to 16-bit")
        result = (result.astype(np.float32) * 257).astype(np.uint16)  # Scale 8-bit to 16-bit
    
    # Write output
    if not cv2.imwrite(output_path, result):
        raise RuntimeError(f"Failed to write image: {output_path}")
    
    dbg(f"Applied curve to {output_path}")

def find_step_wedge_region(gray: np.ndarray,a) -> tuple[np.ndarray, int] | None:
    """Detect the step wedge region by finding the white/black/white bar pattern. Returns (quad, wedge_width) or None."""
    h, w = gray.shape
    
    # Search in rightmost 30% of image for the bar pattern
    search_width = int(w * 0.3)
    right_region = gray[:, -search_width:]
    
    # Use edge detection to find vertical structures
    blur = cv2.GaussianBlur(right_region, (11,11), 0)
    edges = cv2.Canny(blur, 50, 150)
    edges = cv2.dilate(edges, None, iterations=2)
    
    # Find vertical lines
    thr = int(h*0.6)
    mll = int(h*0.3)
    xlg = int(h*0.02)
    lines = cv2.HoughLinesP(edges, 1, np.pi/180, threshold=thr,
                            minLineLength=mll, maxLineGap=xlg)
    #dbg(f"HoughLinesP thr:{thr} mll:{mll} xlg:{xlg} lines{len(lines)}")
    
    if lines is None:
        return None
    
    # Find rightmost vertical line (right edge of bar)
    vertical_lines = []
    for line in lines:
        x1, y1, x2, y2 = line[0]
        angle = np.abs(np.arctan2(y2 - y1, x2 - x1) * 180 / np.pi)
        if angle > 80 and angle < 100:
            vertical_lines.append((max(x1, x2), min(y1, y2), max(y1, y2), x1, y1, x2, y2))
    
    if not vertical_lines:
        return None
    
    # Sort by x position and get rightmost line
    vertical_lines.sort(key=lambda x: x[0], reverse=True)
    right_edge_x, top_y, bottom_y, x1, y1, x2, y2 = vertical_lines[0]
    right_edge_x += (w - search_width)  # Convert to full image coordinates

    # Calculate angle of the detected line
    angle_rad = np.arctan2(y2 - y1, x2 - x1)    

    # Debug: draw detected lines
    if a.debug:
        debug_img = cv2.cvtColor(edges, cv2.COLOR_GRAY2BGR)
        v=0
        for i, (x, y1, y2, *_) in enumerate(reversed(vertical_lines)):
            c=(0,v,0)
            v=v+255/len(vertical_lines)
            if i==len(vertical_lines)-1:
                c=(0,0,255)
            cv2.line(debug_img, (x, y1), (x, y2), c, 2)
        debug_path = a.debug.replace('.', '_lines.')
        cv2.imwrite(debug_path, debug_img)
        dbg(f"Drew {len(vertical_lines)} vertical lines to {debug_path}")
    
    # Bar height from detected vertical line
    segments = a.segments
    bar_height = int( (bottom_y - top_y)*segments/(segments - 2))
    segment_height = bar_height/segments
    wedge_width = int(bar_height / 5)
    
    # Left edge of wedge
    left_edge_x = right_edge_x - wedge_width
    
    # Create rotated quad using the detected angle
    # Direction perpendicular to the line
    dx = np.cos(angle_rad)
    dy = np.sin(angle_rad)
    # Direction along the line
    px = -dy
    py = dx
    
    # Center point of the right edge (in full image coordinates)
    center_x = right_edge_x
    center_y = top_y 
    # Extend vertically by one segment on each side
    half_height = (bottom_y - top_y)  +  segment_height
    
    # Build quad corners following the rotation
    # Start from center and move along/perpendicular to the detected line
    quad = np.array([
        [center_x - wedge_width * px + segment_height * dx, center_y - wedge_width * py + segment_height * dy],  # top-left
        [center_x + segment_height * dx, center_y + segment_height * dy],  # top-right
        [center_x - half_height * dx, center_y - half_height * dy],  # bottom-right
        [center_x - wedge_width * px - half_height * dx, center_y - wedge_width * py - half_height * dy]   # bottom-left
    ], dtype=np.float32)

    return quad, wedge_width

def read_step_wedge(a) -> list[tuple[int, int]]:
    """Read step wedge values from an image and output CSV."""
    input_path = a.image
    output_csv = a.read_wedge
    
    img = cv2.imread(input_path, cv2.IMREAD_GRAYSCALE)
    if img is None:
        raise ValueError(f"Cannot read image: {input_path}")
    
    dbg(f"Image shape: {img.shape}")
    
    # Try to detect the step wedge region
    detection = find_step_wedge_region(img,a)
    
    if detection is None:
        # Fallback: assume wedge is rightmost 200px (or proportional)
        h, w = img.shape
        wedge_width = min(200, int(w * 0.15))
        dbg(f"Could not detect wedge region, using rightmost {wedge_width}px")
        wedge = img[:, -wedge_width:]
        warp_size = 1000
    else:
        quad, detected_width = detection
        dbg(f"Detected wedge region with width ~{detected_width}px")
        
        # Warp to standard size
        warp_size = 1000
        wedge_target_width = 200
        dst = np.array([
            [0, 0],
            [wedge_target_width - 1, 0],
            [wedge_target_width - 1, warp_size - 1],
            [0, warp_size - 1]
        ], dtype=np.float32)
        
        M = cv2.getPerspectiveTransform(quad, dst)
        wedge = cv2.warpPerspective(img, M, (wedge_target_width, warp_size), 
                                     flags=cv2.INTER_CUBIC)
        wedge_width = wedge_target_width
    
    # Create debug image if requested
    if a.debug:
        debug_img = cv2.cvtColor(wedge, cv2.COLOR_GRAY2BGR)

    # Step wedge parameters
    segments = a.segments
    h = wedge.shape[0]
    
    # Measure each segment
    segment_height = h / segments
    data = []
    
    # Determine sampling area (avoid gradient and bars on the right)
    step_width = int(wedge_width * 0.65)  # Use left 65% of wedge
    
    for j in range(segments):
        y_start = int(j * segment_height)
        y_end = int((j + 1) * segment_height)
        
        # Add vertical margin to avoid segment boundaries
        y_margin = max(1, int(segment_height * 0.1))
        y_start += y_margin
        y_end -= y_margin
        
        roi = wedge[y_start:y_end, 0:step_width]
        
        # Measure median value
        measured_value = int(np.median(roi))
        
        # Draw ROI rectangle on debug image
        if a.debug:
            cv2.rectangle(debug_img, (0, y_start), (step_width, y_end), (0, 255, 0), 1)

        # Expected value based on progression
        if a.progression == "linear":
            expected_value = round(255 - 255 * (j / (segments - 1)))
        elif a.progression == "stops":
            expected_value = round(255 * (2 ** (-j / 3)))
        elif a.progression == "inv_stops":
            inverted = round(255 * (2 ** (-j / 3)))
            expected_value = 255 - inverted
        else:
            expected_value = round(255 - 255 * (j / (segments - 1)))
        
        data.append((expected_value, measured_value))
    
    # Save debug image
    if a.debug:
        if not cv2.imwrite(a.debug, debug_img):
            raise RuntimeError(f"Failed to write debug image: {a.debug}")
        dbg(f"Debug image written to: {a.debug}")
    
    write_csv(output_csv, data)
    dbg(f"Read {len(data)} step wedge segments from {input_path} and wrote to {output_csv}")
    return data

def main() -> int:
    ap = argparse.ArgumentParser()
    def usage(message: str):
        print(__doc__)
        ap.print_help()
        print(f"\nError: {message}", file=sys.stderr)
        sys.exit(1)

    ap.error = usage
    ap.add_argument("--generate", metavar="OUT_IMAGE", help="Generate a printable ramp chart image")
    ap.add_argument("--step-wedge", action="store_true", help="Generate a 21-segment step wedge or append one when using --apply")
    ap.add_argument("--read-wedge", metavar="OUT_CSV", help="Read step wedge values from image and output CSV")
    ap.add_argument("--apply", nargs=2, metavar=("CURVE", "OUTPUT"), help="Apply curve to an image")
    ap.add_argument("--size", type=int, help="Apply: resize maximum dimension to this size before applying curve")
    ap.add_argument("--progression", type=str, default='linear', help="Step wedge progression: linear, stops, inv_stops (default linear)")
    ap.add_argument("image", nargs="?", help="Input photo/scan containing the NxN ramp grid (reader mode)")
    ap.add_argument("out_csv", nargs="?", help="Output CSV path (reader mode)")
    ap.add_argument("--warpsize", type=int, default=1000, help=argparse.SUPPRESS) #help="Reader: warp canvas size (pixels), default 1000"
    ap.add_argument("--debug", help=argparse.SUPPRESS) #help="Reader: optional path to save the warped grayscale image")
    ap.add_argument("--variance", type=str, default=None, help=argparse.SUPPRESS) #help="Reader: optional path to save a variance chart")
    ap.add_argument("--grid", type=int, default=32, help="Chart: size for a grid x grid chart (default 32)")
    ap.add_argument("--shuffle", type=str, default='blue_noise', 
                    help="Chart: shuffle methods: none, blue_noise, gcd, hilbert, split, shuffle, maximize_closest (default blue_noise)")
    ap.add_argument("--cell", type=int, default=40, help=argparse.SUPPRESS) #help="Chart: cell size in pixels (default 40)")
    ap.add_argument("--invert-chart", action="store_true", help="Chart: invert patch levels ")
    ap.add_argument("--margin", type=int, default=40, help=argparse.SUPPRESS) #help="Chart: outer margin in pixels (default 80)")
    ap.add_argument("--line", type=int, default=1, help=argparse.SUPPRESS) #help="Chart: internal grid line thickness (default 1)")
    ap.add_argument("--border", type=int, default=10, help=argparse.SUPPRESS) #help="Chart: outer border thickness (default 10)")
    ap.add_argument("--segments", type=int, default=21, help=argparse.SUPPRESS) #"Step wedge: number of segments (default 21)")
    #ap.add_argument("--wedge-width", type=int, default=200, help="Step wedge: width in pixels (default 200)")
    #ap.add_argument("--wedge-height", type=int, default=1000, help="Step wedge: height in pixels (default 1000)")
    #ap.add_argument("--no-gradient", action="store_true", help="Step wedge: exclude gradient")
    #ap.add_argument("--no-bars", action="store_true", help="Step wedge: exclude black/white bars")
    args = ap.parse_args( )

    # Apply mode
    if args.apply:
        if not args.image:
            ap.error("Apply mode requires: image --apply CURVE OUTPUT")
        apply_curve(args)
        return 0

    # Read step wedge mode
    if args.read_wedge:
        if not args.image:
            ap.error("Read wedge mode requires: image --read-wedge OUT_CSV")
        read_step_wedge(args)
        return 0    

    # Generator mode
    if args.generate:
        generate_chart(args)
        return 0

    if args.step_wedge:
        if not args.image:
            ap.error("Step wedge generation requires output path as first argument")
        generate_step_wedge(args)
        return 0


    # Reader mode
    if not args.image or not args.out_csv:
        ap.error("Reader mode requires: image out_csv (or use --generate OUT_IMAGE).")

    data = read_chart(args)
    if args.variance:
        generate_variance_chart(data, args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

