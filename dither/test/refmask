#!/usr/bin/env python3
"""Turn a sample into the mask it would be if we could just use it directly:
high-pass, take a centred crop, rank to a flat 0..254. """
import os,sys
import cv2, numpy as np

def rank_flat(c):
    """Flat 0..254 by rank -- what makes a field a threshold mask."""
    m = np.empty(c.size, np.uint8)
    m[np.argsort(c.ravel(), kind='stable')] = np.round(np.arange(c.size) * 254 / (c.size - 1))
    return m.reshape(c.shape)

def rank_flat_rnd(c, seed=None):
    """Flat 0..254 by rank with equal values randomised."""
    rng = np.random.default_rng(seed)
    noise = rng.random(c.size)
    order = np.lexsort((noise, c.ravel()))
    m = np.empty(c.size, np.uint8)
    m[order] = np.round(np.arange(c.size) * 254 / (c.size - 1))
    return m.reshape(c.shape)

def high_pass(f, px):
    """High-pass filter with a Gaussian cutoff."""
    fy = np.fft.fftfreq(f.shape[0])[:, None]; 
    fx = np.fft.fftfreq(f.shape[1])[None, :]
    g = np.exp(-2 * np.pi**2 * (0.1874 * px)**2 * (fy**2 + fx**2))
    return  np.real(np.fft.ifft2(np.fft.fft2(f - f.mean()) * (1 - g))) 

def crop(f, W, H):
    """Crop to a centred rectangle."""
    y0, x0 = (f.shape[0] - H) // 2, (f.shape[1] - W) // 2
    return f[y0:y0+H, x0:x0+W].ravel()

def quantise(f, step):
    """Round the field to a grid just below the sample's information floor."""
    if step <= 0:
        return f
    return np.rint(np.asarray(f, np.float64) / step) * step

src, px, W, H, quant, rnd, out = sys.argv[1], float(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4]), float(sys.argv[5]), sys.argv[6], sys.argv[7] 
if len(sys.argv) < 8:
    sys.exit("Usage: refmask <src> <px> <W> <H> <quant> <rnd> <out>")
rnd = rnd in ['1','true','True'] 
f = cv2.imread(src, 0).astype(np.float64)

if px > 0:
    f = high_pass(f, px)
f = quantise(f, 1/quant)  #1/256
c = crop(f, W, H)
m = rank_flat_rnd(c) if rnd else rank_flat(c)
# Threshold order, as dither writes it: the lowest cells light first, so they go
# where the sample is brightest.
cv2.imwrite(out, (254 - m).reshape(H, W))
