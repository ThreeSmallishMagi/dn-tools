#!/usr/bin/env gnuplot
# Plot colstats --csv output.
# Usage:  gnuplot colplot
#         gnuplot -e 'file="other.csv"' colplot
#         gnuplot -e 'file="x.csv"; tol=3' colplot
#         gnuplot -e 'file="x.csv"; png="output.png"' colplot

if (!exists("file")) file = "dither.csv"
if (!exists("tol"))  tol  = 3.0

if (exists("png")) {
    set terminal pngcairo size 1000,750 enhanced font "sans,11" background rgb "#f5f5f5"
    if (png ne "" && png ne "-") {
        set output png
    }
} else {
    set terminal sixelgd size 1000,750 enhanced font "sans,11" background rgb "#f5f5f5"
}
set datafile separator ","

set multiplot layout 2,1 title file noenhanced \
    margins 0.10,0.97,0.07,0.95 spacing 0,0.04

# ── panel 1: column means (sRGB pixel space, 0-255) ───────────────────────
set ylabel "column mean"
set format x ""
set xtics 0,32,255
set ytics 0,32,255
set mxtics 4
set xrange [0:255]
set yrange [0:255]
set grid lc rgb "#cccccc"
set key top left
set object 1 rectangle from graph 0,0 to graph 1,1 behind fillcolor rgb "#ffffff" fillstyle solid noborder
plot file using 1:2 title "ref" with lines lc rgb "#888888" lw 1, \
     file using 1:3 title "out" with lines lc rgb "#377eb8" lw 1

# ── panel 2: z-score with ±tol threshold ─────────────────────────────────
set ylabel "z-score"
set xlabel "column"
set format x "%g"
set yrange [*:*]
set ytics auto
set mytics 2
unset key
set grid lc rgb "#cccccc"
plot file using 1:5 with lines lc rgb "#377eb8" lw 1 title "z", \
      tol with lines lc rgb "#e41a1c" lw 1 dt 2 notitle, \
     -tol with lines lc rgb "#e41a1c" lw 1 dt 2 notitle

unset multiplot
