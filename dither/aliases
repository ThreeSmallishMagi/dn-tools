rampdiff() #       Usage: rampdiff [image [result [reference [scale ]]]]
{ 
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    local ref=${3:-examples/ramp_256x256.png}
    local scale=${4:-10}
#    local threshold=${5:-0.1}
#    convert "$ref" "$img" -compose minus -composite -evaluate multiply 10 -evaluate add 128 -filter point -resize 1000x1000 "$res"

      convert "$img" "$ref" -colorspace Gray \
          \( -clone 0 -clone 1 -fx "max($scale*(u-v),0)" \) \
          \( -clone 0 -clone 1 -fx "max($scale*(v-u),0)" \) \
          -delete 0,1 \
          \( -clone 1 \) \
          -combine \
          -filter point \
          "$res"
}

analyse() 
{
    img=${1:-dither.png}
    lin=${2:-}
    grp=${3:-1}
    ref=${4:-examples/ramp_256x256.png}
    res=${5:-sixel:-}

    test/colstats --csv dither.csv --group $grp $lin $img  $ref |grep RESULT | grep -e 'RESULT\|FAIL'
    convert $img <(rampdiff $img - $ref) <(gnuplot -e 'png="-"' test/colplot) \
    -resize x1000 +append -filter point -resize 2000x $res
}

add_caption() #    Add a text caption to the bottom of an image
{
    local img=$1
    local caption=$2
    local out=${3:-$img}
    local width
    width=$(identify -format "%w" "$img")
    convert "$img" \
        \( -size "${width}x30" -background white -pointsize 10 caption:"$caption" \) \
        -gravity South -append \
        "$out"
}

dither_with_caption()
{
    local input=$1 output=$2
    shift 2
    dither "$input" "$@" --out "$output"
    add_caption "$output" "$*"
}

examples()
{
    convert examples/ramp_256x256.png <(convert examples/m039crop.png -resize 256 -)  +append ex.png

    local -A groups=(
        [examples]=""
        [examples_spatial]="--spatial 1"
        [examples_levels]="--levels 8"
        [examples_frames]="--frames 8"
    )

    local order=(examples examples_spatial examples_levels examples_frames)

    for key in "${order[@]}"; do
        local extra="${groups[$key]}"
        local files=()
        for thresh in round random mask; do
            local out="ex_${thresh}_${key}.png"
            dither_with_caption ex.png "$out" --threshold "$thresh" $extra
            files+=("$out")
        done
        convert "${files[@]}" -append -filter point -resize 1000x "${key}.png"
        rm "${files[@]}"
    done

    rm ex.png
}

generators()
{
    local sample=${1:-Kodak-4X}
    local img=${2:-examples/m039crop.png}
    local res=${3:-generators.png}
    convert $img -resize 256  ex.png

    local -A groups=(
        [examples]=""
        [examples_spatial]="--supersample 4"
        [examples_levels]="--supersample 8"
        [examples_frames]="--supersample 12 --mask-scale 2"
    )

    local order=(examples examples_spatial examples_levels examples_frames)
    local col_images=()

    for key in "${order[@]}"; do
        local extra="${groups[$key]}"
        local files=()
        for gen in dft markov inpaint direct; do
            local out="ex_${gen}_${key}.png"
            dither_with_caption ex.png "$out" --mask-sample ${sample} --mask-method  "$gen" $extra
            files+=("$out")
        done
        convert "${files[@]}" -append -filter point -resize 1000x "${key}.png"
        rm "${files[@]}"
        col_images+=("${key}.png")
    done

    convert "${col_images[@]}" +append -filter point "${res}"
    rm "${col_images[@]}"
    rm ex.png
}

