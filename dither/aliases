alias activate='. */bin/activate'

install_deps() #   Install apt-packages.txt and requirements.txt
{
    command -v apt-get >/dev/null || { echo "not Debian — see the README for the brew line" >&2; return 1; }
    sudo apt-get install $(cat apt-packages.txt) || return 1

    [ -d dither_env ] || python3 -m venv dither_env || return 1
    dither_env/bin/pip install -qr requirements.txt || return 1
    export PATH="$PWD/dither_env/bin:$PATH"
    python3 -c 'import cv2, numpy; print(f"ready: cv2 {cv2.__version__}, numpy {numpy.__version__}")'
}

build() #          Configure, build, then show the manual.
{
    cmake -B build "$@" && cmake --build build && help
}

deploy() #         Copy the git-tracked files to the public repo
{
    local src publicrepo
    src=$(cd "${1:-.}" && pwd) || return 1
    publicrepo="$src/../../public/dn-tools/dither"

    ( cd "$src" || exit 1
      mkdir -p "$publicrepo" || exit 1
      git ls-files | while IFS= read -r f; do
          [ -f "$f" ] || continue          # tracked but deleted locally
          if [ -x "$f" ]; then mode=755; else mode=644; fi
          mkdir -p "$publicrepo/$(dirname "$f")"
          install -m "$mode" "$f" "$publicrepo/$f"
      done ) || return 1
    echo "deployed $(git -C "$src" ls-files | wc -l) tracked files to $publicrepo"
}

# Install the bash completion for dither and maketexture
install_completion() 
{
    local src="$PWD/completion/dither"
    [ -f "$src" ] || { echo "no $src — run this from the project root" >&2; return 1; }
    local dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
    mkdir -p "$dir" || return 1
    cp "$src" "$dir/dither" || return 1
    # bash-completion loads lazily by command name, so maketexture needs its own
    # entry or it would only complete once dither had been completed first.
    ln -sf dither "$dir/maketexture" || return 1
    echo "installed $dir/dither (and maketexture -> dither)"
    echo "  active in new shells; 'source $src' for this one"
}

# Seed ~/.config/dither/samples with the shipped scans and dither/crops with their
# crops, then calibrate them (--no-calibrate to skip that part)
install_samples() 
{
    local map="$PWD/examples/films.tsv"
    [ -f "$map" ] || { echo "no $map — run this from the project root" >&2; return 1; }
    local py="$PWD/dither_env/bin/python"
    [ -x "$py" ] || { echo "no $py — run install_deps first; the crops are cut with its cv2" >&2; return 1; }
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/dither"
    local root="$cfg/samples"
    local added=0 kept=0 differ=0 missing=0 film scan rest f
    # Never overwrites. The library is the user's own, and may already hold
    # their scans under these names; adding to it is a convenience, replacing
    # what is in it is not this function's business.
    while IFS=$'\t' read -r film scan rest; do
        case "$film" in ''|\#*) continue ;; esac
        if [ ! -f "examples/$scan" ]; then
            echo "  missing examples/$scan" >&2
            missing=$((missing + 1)); continue
        fi
        mkdir -p "$root/$film" || return 1
        if [ ! -e "$root/$film/$scan" ]; then
            cp "examples/$scan" "$root/$film/$scan" || return 1
            added=$((added + 1))
        elif cmp -s "examples/$scan" "$root/$film/$scan"; then
            kept=$((kept + 1))
        else
            echo "  kept $root/$film/$scan, which differs from examples/$scan;" \
                 "if it is an old crop, delete it and run this again"
            differ=$((differ + 1))
        fi
        # The library once held crops rather than scans, under the scan's stem.
        # Left beside the scan, a crop is pooled with it and its pixels counted
        # twice, so say so; deleting it is the user's call.
        for f in "$root/$film/${scan%.*}".*; do
            [ -e "$f" ] && [ "$f" != "$root/$film/$scan" ] &&
                echo "  $f looks like an old crop of $scan; delete it, or the generators pool both"
        done
    done < "$map"
    local extra=""
    [ "$differ" -gt 0 ] && extra+=", $differ differ"
    [ "$missing" -gt 0 ] && extra+=", $missing missing"
    echo "sample library $root: $added added, $kept already there$extra"
    # The venv's bin first rather than "$py" in front: the script stays the
    # thing that runs, and it still gets the python the check above found.
    PATH="$PWD/dither_env/bin:$PATH" test/findcrops --install "$cfg/crops" || return 1
    # Informational only: a successful install with nothing built to list from
    # is still a successful install.
    local exe="$PWD/build/dither"
    [ -x "$exe" ] && echo "  films: $("$exe" --list-samples | tr '\n' ' ')"
    # After the crops, which are what a calibration is scored against.
    [ "${1:-}" = --no-calibrate ] || calibrate_samples || return 1
    [ "$missing" -eq 0 ]
}

# Calibrate films in the library at the default settings, so a later run takes
# the measurement from the config instead of paying for it. Every film and
# every generator that can calibrate, unless some are named:
#   calibrate_samples [film...] [-- method...]
# One run at a time, since each writes the same config file. A film already
# calibrated is read back rather than measured, so this is safe to repeat; it
# takes about two minutes a film the first time, almost all of it markov.
calibrate_samples()
{
    local exe="$PWD/build/dither"
    [ -x "$exe" ] || { echo "no $exe -- run build first" >&2; return 1; }
    local -a films=() methods=()
    while [ $# -gt 0 ] && [ "$1" != -- ]; do films+=("$1"); shift; done
    [ "${1:-}" = -- ] && shift
    methods=("$@")
    [ ${#films[@]} -gt 0 ] || mapfile -t films < <("$exe" --list-samples)
    [ ${#methods[@]} -gt 0 ] || methods=(dft inpaint markov)
    local out film m said
    out="$(mktemp --suffix=.png)"
    echo "calibrating ${#films[@]} film(s) for ${methods[*]}"
    for film in "${films[@]}"; do
        for m in "${methods[@]}"; do
            # The mask size is not in any calibration's key, so the build that
            # follows the calibration is kept small; the image is never used.
            said="$("$exe" "$PWD/examples/ramp_256x256.png" --threshold mask \
                    --mask-method "$m" --mask-sample "$film" --mask-calibrate \
                    --mask-size 64x64 --out "$out" 2>&1 >/dev/null)" ||
                { echo "  $film $m: failed"; echo "$said" | tail -3; rm -f "$out"; return 1; }
            printf '  %-18s %-8s %s\n' "$film" "$m" "$(echo "$said" |
                grep -E 'measured for this|stays at|calibrated markov|keeping the derived|previous calibration' |
                tail -1 | sed -e 's/^ *//' -e 's/ (.*//')"
        done
    done
    rm -f "$out"
}

