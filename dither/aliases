test_dither() 
{
    local args="$@"
    echo
    echo  $args
    dither examples/ramp_256x256.png $args && analyse
}

run_suite() 
{
    local extra_args="$@"
    test_dither $extra_args
    test_dither --threshold random $extra_args
    test_dither --threshold random --spatial 1 $extra_args
    test_dither --threshold mask $extra_args
    test_dither --threshold mask --spatial 0.5 $extra_args
    test_dither --threshold mask --spatial 1 $extra_args
    test_dither --threshold mask --mask-method dft --mask-sample examples/Kodak-4X-1.png $extra_args
    test_dither --threshold mask --mask-method markov --mask-sample examples/Kodak-4X-1.png $extra_args
    test_dither --threshold mask --mask-method inpaint --mask-sample examples/Kodak-4X-1.png --supersample 6 $extra_args
    test_dither --threshold mask --mask-method direct --mask-sample examples/Kodak-4X-1.png --supersample 6 $extra_args
}

gallery() #        Show what various combinations of options do
{
    run_suite
    echo "\n-- multi frame average --"
    run_suite --frames 16
    echo "\n-- bit depth 3 --"
    run_suite --levels 8
}

colordither()
{
    if [ $# -lt 3 ]; then
        echo "Usage: colordither <input> <output> <channel_script> [options]" >&2
        return 1
    fi

    local input="$1" output="$2" script="$3" tmp
    shift 3
    tmp=$(mktemp -d) || return 1

# Split into R, G, B channels
    convert "$input" -channel R -separate -strip "$tmp/r.png"
    convert "$input" -channel G -separate -strip "$tmp/g.png"
    convert "$input" -channel B -separate -strip "$tmp/b.png"

# Process each channel
    "$script" "$tmp/r.png" --out "$tmp/r_out.png" "$@"
    "$script" "$tmp/g.png" --out "$tmp/g_out.png" "$@"
    "$script" "$tmp/b.png" --out "$tmp/b_out.png" "$@"

# Combine back into color image
    convert "$tmp/r_out.png" "$tmp/g_out.png" "$tmp/b_out.png" \
    -combine -colorspace sRGB "$output"
    local status=$?
    rm -rf "$tmp"
    return $status
}

foreach() #        Run a command template for each argument: foreach a b c -- cmd {} --flag
{
    local args=() cmd=() arg
    local in_cmd=0
    for arg in "$@"; do
        # Only the first -- separates; later ones belong to the command, which
        # may need its own end-of-options marker to pass a filename beginning
        # with a dash.
        if [ $in_cmd -eq 0 ] && [ "$arg" = "--" ]; then in_cmd=1; continue; fi
        if [ $in_cmd -eq 0 ]; then args+=("$arg"); else cmd+=("$arg"); fi
    done
    [ ${#cmd[@]} -gt 0 ] || { echo "foreach: no command after --" >&2; return 2; }
    local rc=0
    for arg in "${args[@]}"; do
        "${cmd[@]//\{\}/$arg}" || rc=$?
    done
    return $rc
}

