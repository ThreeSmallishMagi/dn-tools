test_dither() 
{
    local args="$@"
    dither examples/ramp_256x256.png $args && analyse
}

run_suite() 
{
    local extra_args="$@"
    test_dither $extra_args
    test_dither --threshold random $extra_args
    test_dither --threshold random --spatial 1 $extra_args
    test_dither --threshold blue $extra_args
    test_dither --threshold blue --spatial 0.5 $extra_args
    test_dither --threshold blue --spatial 1 $extra_args
}

gallery() #        Show what various combinations of options do
{
    run_suite
    echo "-- multi frame average --"
    run_suite --frames 16
    echo "-- bit depth 3 --"
    run_suite --levels 8
}

help() 
{
    local mdfile=${1:-README.md}
    if command -v pandoc >/dev/null 2>&1; then
        pandoc -s -t man "$mdfile" | man -l -
    else
        less "$mdfile"
    fi
}


