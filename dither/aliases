icrop() 
{
    local img=${1:-dither.png}
    local ox=${2:-128}
    local oy=${3:-128}
    convert \
        \( "$img" -crop 768x768+$ox+$oy +repage -filter point -resize 1024x1024 \) \
        \( "$img" -crop 256x256+$(($ox+192))+$(($oy+192)) +repage -interpolate nearest -filter point -resize 1024x1024 \) \
        +append sixel:-;}

isquash() 
{
    if [ $# -lt 1 ]; then
        echo "Usage: isquash <image> [result [rows [cols]]]" >&2
        return 1
    fi
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    local rows=${3:-10}

    local w
    local h
    w=$(identify -format "%w" "$img") || return 1
    h=$(identify -format "%h" "$img") || return 1

    local cols=${3:-$w}

    convert "$img" \
        -colorspace RGB \
        -filter box -resize "${cols}x${rows}!" \
        -colorspace sRGB \
        -filter point -resize "${w}x${h}!" \
        "$res"
}

iaverage() 
{
    if [ $# -lt 2 ]; then
        echo "Usage: iaverage <output> <image1> <image2> [image3 ...]" >&2
        return 1
    fi
    local output=$1
    shift
    convert "$@" -evaluate-sequence mean "$output"
}

histo() 
{
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    convert $img -colorspace gray histogram:$res
}

