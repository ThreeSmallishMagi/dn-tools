install_deps() #   Install apt-packages.txt and requirements.txt
{
    command -v apt-get >/dev/null || { echo "not Debian — see the README for the brew line" >&2; return 1; }
    sudo apt-get install $(cat apt-packages.txt) || return 1

    [ -d dither_env ] || python3 -m venv dither_env || return 1
    dither_env/bin/pip install -qr requirements.txt || return 1
    export PATH="$PWD/dither_env/bin:$PATH"
    python3 -c 'import cv2, numpy; print(f"ready: cv2 {cv2.__version__}, numpy {numpy.__version__}")'
}

build() #          Configure, build, then show the manual.
{
    cmake -B build "$@" && cmake --build build && help
}

deploy() #         Copy the git-tracked files to the public repo
{
    local src publicrepo
    src=$(cd "${1:-.}" && pwd) || return 1
    publicrepo="$src/../../public/dn-tools/dither"

    ( cd "$src" || exit 1
      mkdir -p "$publicrepo" || exit 1
      git ls-files | while IFS= read -r f; do
          [ -f "$f" ] || continue          # tracked but deleted locally
          if [ -x "$f" ]; then mode=755; else mode=644; fi
          mkdir -p "$publicrepo/$(dirname "$f")"
          install -m "$mode" "$f" "$publicrepo/$f"
      done ) || return 1
    echo "deployed $(git -C "$src" ls-files | wc -l) tracked files to $publicrepo"
}

md() #             Read a markdown file
{ 
    pandoc -s -t man $* | man -l -
}

icat() #           Display an image in the terminal
{ 
    for f in $*;
    do
        #convert  $f -resize 1000x\> png:- |img2sixel -I
        convert  $f -filter point -resize 1000x1000 sixel:-
    done
}

dim () #           Display the dimensions of an image
{ 
    for f in $*;
    do
        identify -format "%wx%h\n" $f;
    done
}

imagefmt () #      Show properties of an image
{ 
    local img=$1
    identify -format "FileName:%[filename]\nSize:%[w]x%[h]\nColorSpace:%[colorspace]\nBitDepth:%[depth]\nGamma:%[gamma]\n" $img
}

icrop() 
{
    if [ $# -lt 3 ]; then
        echo "Usage: icrop <image> <x> <y>" >&2
        return 1
    fi
    convert $1 -filter point -resize 1000x1000 sixel:-;
    convert "$1" -crop 500x500+$2+$3 +repage -filter point -resize 1000x1000 sixel:-;
    convert "$1" -crop 100x100+$(($2 +128))+$(($3 + 128)) +repage -interpolate nearest -filter point -resize 1000x1000 sixel:-;
}

isquash() 
{
    if [ $# -lt 1 ]; then
        echo "Usage: isquash <image> [result [rows [cols]]]" >&2
        return 1
    fi
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    local rows=${3:-10}

    local w
    local h
    w=$(identify -format "%w" "$img") || return 1
    h=$(identify -format "%h" "$img") || return 1

    local cols=${3:-$w}

    convert "$img" \
        -colorspace RGB \
        -filter box -resize "${cols}x${rows}!" \
        -colorspace sRGB \
        -filter point -resize "${w}x${h}!" \
        "$res"
}

iaverage() 
{
    if [ $# -lt 2 ]; then
        echo "Usage: iaverage <output> <image1> <image2> [image3 ...]" >&2
        return 1
    fi
    local output=$1
    shift
    convert "$@" -evaluate-sequence mean "$output"
}

histo() 
{
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    convert $img -colorspace gray histogram:$res
}

rampdiff() #       Usage: rampdiff [image [result [reference [scale ]]]]
{ 
    local img=${1:-dither.png}
    local res=${2:-sixel:-}
    local ref=${3:-examples/ramp_256x256.png}
    local scale=${4:-10}
#    local threshold=${5:-0.1}
#    convert "$ref" "$img" -compose minus -composite -evaluate multiply 10 -evaluate add 128 -filter point -resize 1000x1000 "$res"

      convert "$img" "$ref" -colorspace Gray \
          \( -clone 0 -clone 1 -fx "max($scale*(u-v),0)" \) \
          \( -clone 0 -clone 1 -fx "max($scale*(v-u),0)" \) \
          -delete 0,1 \
          \( -clone 1 \) \
          -combine \
          -filter point \
          "$res"
}

analyse() 
{
    img=${1:-dither.png}
    res=${2:-sixel:-}
    ref=${3:-examples/ramp_256x256.png}

    colstats --csv dither.csv $img  $ref |grep RESULT | grep -e 'RESULT\|FAIL'
    convert $img <(rampdiff $img - $ref) <(gnuplot -e 'png="-"' colplot) \
    -resize x1000 +append -filter point -resize 2000x $res
}

dither_with_caption()
{
    local input=$1
    local output=$2
    shift 2
    local args="$@"
    
    dither "$input" "$@" --out "$output"
    
    local caption="dither ${args}"
    convert "$output" \
        -gravity South -background white -splice 0x25 \
        -pointsize 14 -annotate +0+2 "$caption" \
        "$output"
}

